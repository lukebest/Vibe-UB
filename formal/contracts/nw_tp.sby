# NW↔TP contract asserts. Default tasks have no assume
# (GATE-PRIVATE-PARENT-FREE). BMC depth ≥ deepest cover + 6
# (GATE-FORMAL-DEPTH §5 rule 3). Measured deepest cover 14
# (c_ack_coal / c_psn_wrap). timeout_322/323 are in formal/dll
# (LAYER_CONTRACTS §3: RETRY_WAIT_CYC / PROBE_WAIT_CYC).
[tasks]
cover
bmc
prove

[options]
multiclock off
cover: mode cover
bmc: mode bmc
prove: mode prove
cover: depth 22
bmc: depth 22
prove: depth 22

[engines]
smtbmc z3

[script]
read -formal nw_tp_harness.sv
read -formal nw_tp_assert.sv
prep -top nw_tp_harness

[files]
nw_tp_harness.sv
nw_tp_assert.sv

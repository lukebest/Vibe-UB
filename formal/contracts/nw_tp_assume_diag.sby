# Named diagnostic task: contract assume only.
# Not a default bmc/cover/prove (GATE-PRIVATE-PARENT-FREE).
[tasks]
assume_diag

[options]
multiclock off
assume_diag: mode bmc
assume_diag: depth 22

[engines]
smtbmc z3

[script]
read -sv nw_tp_harness.sv
read -sv nw_tp_assert.sv
read -sv nw_tp_assume.sv
prep -top nw_tp_harness

[files]
nw_tp_harness.sv
nw_tp_assert.sv
nw_tp_assume.sv

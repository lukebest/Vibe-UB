# TP↔TA contract asserts. Default tasks have no assume
# (GATE-PRIVATE-PARENT-FREE). BMC depth ≥ deepest cover + 6
# (GATE-FORMAL-DEPTH §5 rule 3). Planned cover ≤ 16 → BMC 22.
[tasks]
cover
bmc
prove

[options]
multiclock off
cover: mode cover
bmc: mode bmc
prove: mode prove
cover: depth 22
bmc: depth 22
prove: depth 22

[engines]
smtbmc z3

[script]
read -sv tp_ta_harness.sv
read -sv tp_ta_assert.sv
prep -top tp_ta_harness

[files]
tp_ta_harness.sv
tp_ta_assert.sv

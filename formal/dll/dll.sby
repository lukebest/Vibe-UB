# DLL RETRY_WAIT_CYC + LMSM PROBE_WAIT_CYC 322/323 covers
# (LAYER_CONTRACTS §3). Not a TP formal. No assume.
# Deepest cover is probe_323 (step 6) → BMC 12 ≥ 6+6.
[tasks]
cover
bmc
prove

[options]
multiclock off
cover: mode cover
bmc: mode bmc
prove: mode prove
cover: depth 12
bmc: depth 12
prove: depth 12

[engines]
smtbmc z3

[script]
read -formal dll_timeout_harness.sv
read -formal dll_timeout_assert.sv
prep -top dll_timeout_harness

[files]
dll_timeout_harness.sv
dll_timeout_assert.sv

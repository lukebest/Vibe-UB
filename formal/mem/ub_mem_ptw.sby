# ub_mem_ptw PRODUCT port formal (验证-C).
# Stacked on PR #48. Bind / harness uses PRODUCT netlist ports only
# (rtl/mem/ub_mem_ptw.v). No internals, no tb_* observation ports.
#
# ub_mem_ptw_desc_dec is supplied only by cut/ub_mem_ptw_desc_dec.sv
# ($anyseq on every output). Never the PRODUCT stub. After #48
# 52dfc26 the walker file defines only ub_mem_ptw, so there is no
# leftover $abstract stub AST and no delete is needed. The cut is
# the only definition. No duplicate. Properties must hold for ANY
# decode result. No private bit-layout.
#
# pyc_reg.v is only rtl/pyc_lib/pyc_reg.v (#21). This PR does not
# copy it. formal.sh / sby [files] stay red until #21 lands.
#
# Default tasks (scripts/gate/formal.sh: cd formal/mem && sby -f --sequential):
#   cover — reach event, MATT_WD complete, read+rsp, fill,
#           backpressured table-read then accept
#   bmc   — port safety (Q-A08 / Q-C07) + AP_TBLRD_REQ_HOLD (SPEC §14)
#           depth 24 (two full walks + margin; >= deepest cover + 6)
# prove stays untagged. Manual: `sby -f ub_mem_ptw.sby prove`.
# Fully proven via HOOKS prove + PRODUCT≡HOOKS equivalence when CI
# `ub_mem_ptw` equiv is a real PASS (not SKIP/PRIVATE_SKIP) covering
# all PRODUCT outputs except tb_*. Otherwise: bmc 24 PASS, prove
# not converged.
# Local vs #48 52dfc26: cover PASS; bmc 24 PASS 1s; prove UNKNOWN
# (induction FAIL a_matt_no_fill, k=20, 1s). HOOKS prove PASS k=20
# ~1s (default). Encoding table is SPEC §10.
#
# [files] are relative to this directory (sby_dir = formal/mem/).

[tasks]
cover default
bmc default
prove

[options]
cover:
mode cover
depth 16
--
bmc:
mode bmc
depth 24
--
prove:
mode prove
depth 20
--

[engines]
# Same engine as formal/mem/ub_mem_tlb.sby. Walker has no $mem arrays;
# yices at BMC depth 24 is well inside the CI budget.
smtbmc yices

[script]
read -formal ub_mem_ptw.v
read -formal ub_mem_ptw_if_props.sv
read -formal ub_mem_ptw_blk_exp.sv
read -formal ub_mem_ptw_harness.sv
# Only definition of ub_mem_ptw_desc_dec is the cut. Walker file
# instantiates it but does not define it (#48 52dfc26). Read the
# cut (sby copies [files] by basename), then hierarchy once.
# Bound by module name. Do not blackbox (sby prep flatten errors).
read -formal ub_mem_ptw_desc_dec.sv
hierarchy -check -top ub_mem_ptw_harness
cd ub_mem_ptw_desc_dec
setattr -mod -set keep_hierarchy 1
cd ..
proc
flatten
# Tap decoder public ports by instance name (u_dut.u_desc_dec).
connect -set \u_blk_exp.out_valid \u_dut.u_desc_dec.out_valid
connect -set \u_blk_exp.desc_addr \u_dut.u_desc_dec.desc_addr
connect -set \u_blk_exp.desc_kind \u_dut.u_desc_dec.desc_kind
connect -set \u_blk_exp.desc_lvl \u_dut.u_desc_dec.desc_lvl
opt
memory -nomap
opt -purge

[files]
ub_mem_ptw_if_props.sv
ub_mem_ptw_blk_exp.sv
ub_mem_ptw_harness.sv
cut/ub_mem_ptw_desc_dec.sv
../../rtl/pyc_lib/pyc_reg.v
../../rtl/mem/ub_mem_ptw.v

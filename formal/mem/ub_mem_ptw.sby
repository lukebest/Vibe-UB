# ub_mem_ptw PRODUCT port formal (验证-C).
# Stacked on PR #48. Bind / harness uses PRODUCT netlist ports only
# (rtl/mem/ub_mem_ptw.v). No internals, no tb_* observation ports.
#
# ub_mem_ptw_desc_dec is a private leaf. The PRODUCT file inlines a
# handwritten stub that always reports a translation fault. After
# hierarchy this job deletes that module and splices
# ub_mem_ptw_desc_dec_cut.sv ($anyseq on every decoder output) so
# fill / block / page paths stay reachable. Properties must hold for
# ANY decode result. No private bit-layout is read or written.
#
# pyc_reg.v lives in inc/ because #48 has no rtl/pyc_lib (same as
# formal/mem/ub_mem_tlb.sby on the TLB formal branch).
#
# Default tasks (scripts/gate/formal.sh: cd formal/mem && sby -f --sequential):
#   cover — reach event, MATT_WD complete, read+rsp, fill,
#           backpressured table-read then accept
#   bmc   — port safety (Q-A08 / Q-C07) + AP_TBLRD_REQ_HOLD (SPEC §14)
#           depth 24 (two full walks + margin; >= deepest cover + 6)
# prove is defined but not tagged `default` (gatekeeper: not fully
# proven — not a waiver). Manual: `sby -f ub_mem_ptw.sby prove`.
# k=20: basecase PASS, induction FAIL (step 0). CEX start is unreachable
# (st_dec && rd_valid_q; rd_addr_q != addr_q). Yosys 0.33 hierarchical
# refs to DUT regs are implicit undriven wires; port-level one-hot
# auxiliaries were themselves non-inductive. Not assumed, not weakened.
#
# [files] are relative to this directory (sby_dir = formal/mem/).

[tasks]
cover default
bmc default
prove

[options]
cover:
mode cover
depth 16
--
bmc:
mode bmc
depth 24
--
prove:
mode prove
depth 20
--

[engines]
# Same engine as formal/mem/ub_mem_tlb.sby. Walker has no $mem arrays;
# yices at BMC depth 24 is well inside the CI budget.
smtbmc yices

[script]
read -formal ub_mem_ptw.v
read -formal ub_mem_ptw_if_props.sv
read -formal ub_mem_ptw_harness.sv
# read -formal keeps modules as $abstract until hierarchy derives them.
# After hierarchy, drop the inlined stub and splice in the $anyseq cut
# so decoder outputs are unconstrained (any decode result). A Yosys
# `blackbox` cell cannot be flattened (sby prep flatten errors).
hierarchy -check -top ub_mem_ptw_harness
delete ub_mem_ptw_desc_dec
read -formal ub_mem_ptw_desc_dec_cut.sv
hierarchy -check -top ub_mem_ptw_harness
proc
flatten
opt
memory -nomap
opt -purge

[files]
ub_mem_ptw_if_props.sv
ub_mem_ptw_harness.sv
ub_mem_ptw_desc_dec_cut.sv
inc/pyc_reg.v
../../rtl/mem/ub_mem_ptw.v

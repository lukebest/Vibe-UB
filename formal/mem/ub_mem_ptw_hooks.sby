# ub_mem_ptw HOOKS-netlist formal (验证-C). #55.
# Binds rtl/mem/hooks/ub_mem_ptw.v so tb_mem_ptw_obs_st /
# tb_mem_ptw_obs_rd_pend exist. PRODUCT bind stays in ub_mem_ptw.sby
# (no tb_*). Auxiliaries are asserts only, never assumed.
#
# Encoding values: SPEC §10 table (not yet on #50); interim values from
# #48 a06758a / designer posting. Cite SPEC §10 in the localparam block.
#
# Default task: cover only. Unconstrained bmc 24 of a_st_legal FAILs
# at step 9 (obs_st=0): cut fires desc_v=1, desc_kind=KIND_INVALID,
# !illegal — no next-state arm, all one-hot D bits drop. That combo
# is not contract-legal (AP_PTW_FAULT / AP_PTW_KIND_LVL). a_st_legal
# is not weakened. prove stays non-default.
# Diagnostic (untagged): `sby -f ub_mem_ptw_hooks.sby bmc_contract`
# splices ub_mem_ptw_desc_dec_cut_contract.sv ($anyseq + contract
# output-combo assumes). Manual unconstrained: `... bmc` / `prove`.
# hooks-port-consistency may be red until #50 registers the ports.

[tasks]
cover default
bmc
prove
bmc_contract

[options]
cover:
mode cover
depth 16
--
bmc:
mode bmc
depth 24
--
prove:
mode prove
depth 20
--
bmc_contract:
mode bmc
depth 24
--

[engines]
smtbmc yices

[script]
bmc_contract:
read -formal ub_mem_ptw.v
read -formal ub_mem_ptw_if_props.sv
read -formal ub_mem_ptw_hooks_inv.sv
read -formal ub_mem_ptw_hooks_harness.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
delete ub_mem_ptw_desc_dec
read -formal ub_mem_ptw_desc_dec_cut_contract.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
proc
flatten
opt
memory -nomap
opt -purge
--
read -formal ub_mem_ptw.v
read -formal ub_mem_ptw_if_props.sv
read -formal ub_mem_ptw_hooks_inv.sv
read -formal ub_mem_ptw_hooks_harness.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
delete ub_mem_ptw_desc_dec
read -formal ub_mem_ptw_desc_dec_cut.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
proc
flatten
opt
memory -nomap
opt -purge

[files]
ub_mem_ptw_if_props.sv
ub_mem_ptw_hooks_inv.sv
ub_mem_ptw_hooks_harness.sv
ub_mem_ptw_desc_dec_cut.sv
ub_mem_ptw_desc_dec_cut_contract.sv
inc/pyc_reg.v
../../rtl/mem/hooks/ub_mem_ptw.v

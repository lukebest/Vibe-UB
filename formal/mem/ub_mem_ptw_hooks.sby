# ub_mem_ptw HOOKS-netlist formal (验证-C). #55.
# Binds rtl/mem/hooks/ub_mem_ptw.v so tb_mem_ptw_obs_st /
# tb_mem_ptw_obs_rd_pend exist. PRODUCT bind stays in ub_mem_ptw.sby
# (no tb_*). Auxiliaries are asserts only, never assumed.
#
# Encoding values: SPEC §10 table (not yet on #50); interim values from
# #48. Cite SPEC §10 in the localparam block.
#
# Decoder cut is fully free ($anyseq). #48 98818fc catch-all: desc_v=1
# with kind not table/block/page → existing flt_xlat; any state with
# no legal next falls back to st_idle. a_st_legal / a_rd_pend_st are
# checked on that free cut (no contract assumes).
#
# Default tasks: cover + bmc 24. prove stays untagged until it
# converges (gatekeeper moves it). Manual: `sby -f ub_mem_ptw_hooks.sby prove`.
# hooks-port-consistency may be red until #50 registers the ports.

[tasks]
cover default
bmc default
prove

[options]
cover:
mode cover
depth 16
--
bmc:
mode bmc
depth 24
--
prove:
mode prove
depth 20
--

[engines]
smtbmc yices

[script]
read -formal ub_mem_ptw.v
read -formal ub_mem_ptw_if_props.sv
read -formal ub_mem_ptw_hooks_inv.sv
read -formal ub_mem_ptw_hooks_harness.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
delete ub_mem_ptw_desc_dec
read -formal ub_mem_ptw_desc_dec_cut.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
proc
flatten
# Drive hooks_inv taps from the free cut's public ports (Yosys 0.33
# cannot resolve dotted refs or bind). Names are flatten of u_desc_dec.
connect -set tap_dec_out_valid \u_dut.u_desc_dec.out_valid
connect -set tap_desc_v \u_dut.u_desc_dec.desc_v
connect -set tap_desc_kind \u_dut.u_desc_dec.desc_kind
opt
memory -nomap
opt -purge

[files]
ub_mem_ptw_if_props.sv
ub_mem_ptw_hooks_inv.sv
ub_mem_ptw_hooks_harness.sv
ub_mem_ptw_desc_dec_cut.sv
inc/pyc_reg.v
../../rtl/mem/hooks/ub_mem_ptw.v

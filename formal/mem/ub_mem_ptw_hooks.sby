# ub_mem_ptw HOOKS-netlist formal (验证-C). #55.
# Binds rtl/mem/hooks/ub_mem_ptw.v so tb_mem_ptw_obs_st /
# tb_mem_ptw_obs_rd_pend exist. PRODUCT bind stays in ub_mem_ptw.sby
# (no tb_*). Auxiliaries are asserts only, never assumed.
#
# Encoding values: SPEC §10 table (not yet on #50); interim values from
# #48 a06758a / designer posting. Cite SPEC §10 in the localparam block.
#
# Default task: cover only. bmc 24 of a_st_legal FAILs at step 10
# (obs_st=0): unconstrained desc_kind with desc_v=1 matches no
# next-state arm (not TABLE/BLOCK/PAGE) and the walker drops to
# all-zero. That is an RTL hole under "any decode result", not a
# weakened property and not an assume. prove stays non-default.
# Manual: `sby -f ub_mem_ptw_hooks.sby bmc` / `prove`.
# hooks-port-consistency may be red until #50 registers the ports.

[tasks]
cover default
bmc
prove

[options]
cover:
mode cover
depth 16
--
bmc:
mode bmc
depth 24
--
prove:
mode prove
depth 20
--

[engines]
smtbmc yices

[script]
read -formal ub_mem_ptw.v
read -formal ub_mem_ptw_if_props.sv
read -formal ub_mem_ptw_hooks_inv.sv
read -formal ub_mem_ptw_hooks_harness.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
delete ub_mem_ptw_desc_dec
read -formal ub_mem_ptw_desc_dec_cut.sv
hierarchy -check -top ub_mem_ptw_hooks_harness
proc
flatten
opt
memory -nomap
opt -purge

[files]
ub_mem_ptw_if_props.sv
ub_mem_ptw_hooks_inv.sv
ub_mem_ptw_hooks_harness.sv
ub_mem_ptw_desc_dec_cut.sv
inc/pyc_reg.v
../../rtl/mem/hooks/ub_mem_ptw.v

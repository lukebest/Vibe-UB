# ub_mem_tlb HOOKS formal (验证-C).
# Reads the PR #27 hooks netlist plus the lint placeholder for
# ub_cmn_mem_1r1w_d64w109.
#
# pyc_reg.v: same resolution as scripts/check_mem.sh — `inc/pyc_reg.v`
# is filled by get_pyc_inc.sh (rtl/pyc_lib if present, else PR #21
# origin/cursor/cmn-mem-1r1w-5d26). After #21 merges, drop inc/ and
# read `-I rtl/pyc_lib`.
#
# Bound names are HOOKS ports (obs + fill/lk handshake). Array has no
# reset; valid bits do — arbitrary array init is expected.
#
# BMC depth 32:
#   rst_pyc high 4 cycles (smoke convention), then:
#   fill = 3 cycles (accept + CMP + WB); lookup result = request + 1.
#   c_way*_hit: 4 fills (first-invalid ways 0..3) + 4 lookups ~= 20
#   c_all_vld_lkup: 4 fills + 1 lookup ~= 18
#   c_two_fill_same_then_hit: 2 fills + 1 lookup ~= 12
# 32 leaves margin for ready gaps. Cover task uses the same depth.

[tasks]
bmc
cover

[options]
depth 32
bmc:
mode bmc
--
cover:
mode cover
--

[engines]
smtbmc boolector

[script]
# Keep $mem (no FF explosion). prep would map the 4×64×109 arrays.
read -formal ub_cmn_mem_1r1w_d64w109.v
read -formal ub_mem_tlb.v
read -formal ub_mem_tlb_if_props.sv
read -formal ub_mem_tlb_harness.sv
hierarchy -check -top ub_mem_tlb_harness
proc
flatten
opt
memory -nomap
opt -purge

[files]
ub_mem_tlb_if_props.sv
ub_mem_tlb_harness.sv
inc/pyc_reg.v
../../rtl/mem/hooks/ub_mem_tlb.v
../../tb/mem/lint_placeholder/ub_cmn_mem_1r1w_d64w109.v

# Wave-1 CFG9 bypass interface (LAYER_CONTRACTS §2 / §3).
# Formal-only 8-bit-data stub; no product RTL. BMC depth 16 (cover+6).

[tasks]
bmc
cover

[options]
depth 16
bmc:
mode bmc
--
cover:
mode cover
--

[engines]
smtbmc --nopresat z3

[script]
read -formal ub_tp_bypass_if_props.sv
read -formal ub_tp_bypass_formal_ref.sv
read -formal ub_tp_bypass_harness.sv
prep -top ub_tp_bypass_harness

[files]
ub_tp_bypass_if_props.sv
ub_tp_bypass_formal_ref.sv
ub_tp_bypass_harness.sv
